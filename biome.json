{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"noNonNullAssertion": "off",
				"noInferrableTypes": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"overrides": [
		{
			"include": ["tsconfig*.json"],
			"json": {
				"parser": {
					"allowComments": true
				}
			}
		}
	],
	"files": {
		"ignore": [
			"node_modules",
			"dist",
			"storybook-static",
			"test-results",
			"playwright-report",
			"coverage",
			"design_handoff",
			".astro",
			".claude"
		]
	}
}
